# .env.ejemplo — copia este archivo como .env y cambia los valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).
# En Vercel, estos valores se cargan en Settings > Environment Variables.

# Usuario administrador
ADMIN_CORREO=admin@ejemplo.cr
ADMIN_CLAVE=cambia-esta-clave

# Usuario normal
USUARIO_CORREO=usuario@ejemplo.cr
USUARIO_CLAVE=cambia-esta-clave

# Clave para firmar la cookie de sesión: usa un texto largo y aleatorio.
SECRET_KEY=cambia-esta-clave-secreta-larga
